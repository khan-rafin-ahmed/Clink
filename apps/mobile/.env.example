# Thirstee Mobile App Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://arpphimkotjvnfoacquj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mapbox Configuration
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# EAS Configuration (for production builds)
# These should be set as EAS secrets, not in .env files
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "your_key"
# eas secret:create --scope project --name EXPO_PUBLIC_MAPBOX_TOKEN --value "your_token"
