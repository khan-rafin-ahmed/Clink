{
  "name": "thirstee-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Thirstee monorepo with web and mobile apps",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "web:dev": "turbo dev --filter=web",
    "mobile:dev": "turbo dev --filter=mobile",
    "web:build": "turbo build --filter=web",
    "mobile:build": "turbo build --filter=mobile",
    "mobile:build:dev": "cd apps/mobile && npm run build:dev",
    "mobile:build:staging": "cd apps/mobile && npm run build:staging",
    "mobile:build:prod": "cd apps/mobile && npm run build:prod",
    "mobile:submit": "cd apps/mobile && npm run submit",
    "mobile:update:prod": "cd apps/mobile && npm run update:prod",
    "mobile:update:staging": "cd apps/mobile && npm run update:staging"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.8.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
